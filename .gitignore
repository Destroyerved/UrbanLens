# Dependencies
node_modules/
web/node_modules/
landing-page/node_modules/

# Next.js build output
.next/
web/.next/
landing-page/.next/
out/
web/out/
build/
web/build/

# Python caches
__pycache__/
*.pyc
.venv/
backend/.venv/

# Fetch logs / error dumps
raw/osm/*.log
raw/osm/*_err.txt
raw/osm/*_log.txt

# Run logs
logs/
*.log
*.err
*.out
backend/err.log
backend/out.log

# Prebuilt demo DB is intentionally included for fast/free deployment.
# Rebuild with: python scripts/build-fast-cache.py --city ahmedabad

# Raw multi-date built-up rasters (GHSL + Esri) — rebuilt by scripts/fetch_*.py
datasets/ghsl/
datasets/esri/

# Large local data and generated runtime artefacts. The frontend runs from the
# prebuilt payloads in web/public/data; only the lightweight Gujarat config is
# retained from the engine directory.
datasets/
backend/urbanlens.db*
backend/cache/
backend/.cache/
backend/models/
web/data/engine/*
!web/data/engine/gujarat_config.json

# Local delivery archives and temporary package staging directories.
*.zip
package-staging-*/

# Secrets — never commit credentials
*.cdse_token
.sat-credentials
.env
.env.*
*.token
credentials.json
.DS_Store

# Temporary / test folders
landing-delivery/
landing-page/
