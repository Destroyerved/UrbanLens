# Dependencies / builds
node_modules/
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Heavy local stores — rebuilt by the pipeline, never needed at runtime
backend/urbanlens.db
backend/urbanlens.db.*
backend/cache/
# datasets/ is mostly prebuild INPUT (esri/ghsl rasters, re-downloadable from
# their providers) consumed by offline scripts whose outputs ship as tracked
# JSONs. Only what the engine reads per-request at runtime stays tracked:
# the 90 m DEM tiles (flood analysis) and the tiny prediction-training set.
datasets/*
!datasets/dem/
!datasets/dem/**
!datasets/training/
!datasets/training/**

# Raw satellite master (64 MB) — re-fetched daily from GIBS; the rendered
# latest.png + meta.json ARE the committed scene and stay tracked.
*.tiff

# Runtime caches
backend/.cache/
# Per-district crop cache is keyed by date and regenerates on demand.
backend/app/static/thermal/city_*

# Env & OS noise
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# SQLite write-ahead transients. These belong to whichever process has the DB
# open; committing them ships a snapshot that contradicts the DB itself.
backend/urbanlens.db-shm
backend/urbanlens.db-wal
