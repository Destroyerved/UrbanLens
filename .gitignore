# Python caches
__pycache__/
*.pyc

# Fetch logs / error dumps
raw/osm/*.log
raw/osm/*_err.txt
raw/osm/*_log.txt

# Run logs
logs/

# Python
.venv/

# Secrets — never commit credentials
*.cdse_token
.sat-credentials
.env
.env.*
*.token
credentials.json

# backend/models/ is deliberately NOT ignored. The trained development model is
# what makes the 2030 growth layer an actual classifier (PRD §44) rather than
# the proximity heuristic it silently falls back to; ignoring it meant every
# clone served the fallback while the UI described a model. ~2.8 MB of JSON,
# regenerated with: python -m app.ml.train <city>
