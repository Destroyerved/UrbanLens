# Optional. If omitted and backend/urbanlens.db exists, UrbanLens uses it automatically.
URBANLENS_DB=./urbanlens.db

# Public demo default. For private deployment use your Vercel origin instead.
URBANLENS_CORS_ORIGINS=*

# Keep free-host startup bounded.
URBANLENS_PREWARM_BASE=1
URBANLENS_PREWARM_PARCELS=0
URBANLENS_DB_AUTO_SEED=1
URBANLENS_THERMAL_REFRESH=0
